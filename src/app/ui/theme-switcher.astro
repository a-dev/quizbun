---
import { RESOLVED_THEMES } from "../lib/theme-preference";

import { Moon, Sun } from "@lucide/astro";
import { Button } from "@/shared/ui/button";

const options = [
  {
    label: "Light",
    value: RESOLVED_THEMES[0],
    icon: Sun,
  },
  {
    label: "Dark",
    value: RESOLVED_THEMES[1],
    icon: Moon,
  },
];
---

<Button
  data-theme-switcher
  aria-label="Switch to dark theme"
  title="Switch to dark theme"
  variant="ghost"
  size="icon-s"
  className="button"
>
  <span class="icons" aria-hidden="true">
    {
      options.map((option) => {
        const Icon = option.icon;

        return (
          <span class="icon" data-theme-icon={option.value}>
            <Icon size={20} title={option.label} />
          </span>
        );
      })
    }
  </span>
</Button>

<script>
  import {
    applyThemePreference,
    getToggledThemePreference,
    normalizeThemePreference,
    readStoredThemePreference,
    THEME_MEDIA_QUERY,
    THEME_PREFERENCE_ATTRIBUTE,
    writeStoredThemePreference,
    type ResolvedTheme,
    type ThemePreference,
  } from "../lib/theme-preference";

  const labels = {
    light: "light",
    dark: "dark",
  } satisfies Record<ResolvedTheme, string>;

  const switchers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-theme-switcher]"),
  );
  const mediaQuery = window.matchMedia(THEME_MEDIA_QUERY);

  function readPreference() {
    return normalizeThemePreference(
      document.documentElement.getAttribute(THEME_PREFERENCE_ATTRIBUTE),
    );
  }

  function readSystemTheme(): ResolvedTheme {
    return mediaQuery.matches ? "dark" : "light";
  }

  function syncSwitcher(
    button: HTMLButtonElement,
    preference: ThemePreference,
  ) {
    const nextPreference = getToggledThemePreference(
      preference,
      readSystemTheme(),
    );
    const targetTheme =
      nextPreference === "system" ? readSystemTheme() : nextPreference;
    const action = `Switch to ${labels[targetTheme]} theme`;

    button.dataset.themeCurrent = preference;
    button.ariaLabel = action;
    // Only the tooltip mentions the third state, so the control stays
    // two-state visually while the pin remains discoverable.
    button.title =
      nextPreference === "system"
        ? `${action} (back to system default)`
        : action;
  }

  function syncAll(
    preference = normalizeThemePreference(
      document.documentElement.getAttribute(THEME_PREFERENCE_ATTRIBUTE) ??
        readStoredThemePreference(),
    ),
  ) {
    applyThemePreference(preference);

    switchers.forEach((switcher) => {
      syncSwitcher(switcher, preference);
    });
  }

  switchers.forEach((button) => {
    button.addEventListener("click", () => {
      const nextPreference = getToggledThemePreference(
        readPreference(),
        readSystemTheme(),
      );

      writeStoredThemePreference(nextPreference);
      syncAll(nextPreference);
    });
  });

  syncAll();

  mediaQuery.addEventListener("change", () => {
    const preference = readPreference();

    // An explicit preference is only ever re-evaluated on click: dropping a
    // pin because the system theme changed would make pinning impossible for
    // anyone on an OS-level light/dark schedule.
    if (preference === "system") {
      syncAll(preference);
    } else {
      switchers.forEach((switcher) => {
        syncSwitcher(switcher, preference);
      });
    }
  });
</script>

<style>
  .button{
    margin-inline-start: 1rem;
    color: var(--color-text-on-main-bg-dark);
    background: transparent;
  }

  @media(hover: hover) {
    .button:hover {
      background: color-mix(in oklch, var(--color-main-bg-dark) 80%, var(--color-main-bg));
    }
  }

  .icons {
    display: inline-grid;
    place-items: center;
  }

  .icon {
    display: inline-flex;
    grid-area: 1 / 1;
    opacity: 0;
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  :global(html[data-theme="light"]) .button .icon[data-theme-icon="light"],
  :global(html[data-theme="dark"]) .button .icon[data-theme-icon="dark"] {
    opacity: 1;
  }
</style>
