---
import { Font } from "astro:assets";
import { SEO } from "astro-seo";

import "#styles/index.css";

import { withBase } from "@/shared/lib/routing";
import { SITE_DESCRIPTION, SITE_THEME_COLOR, SITE_THEME_COLOR_DARK } from "@/shared/lib/site";

import Header from "./ui/header.astro";
import Footer from "./ui/footer.astro";
import { createThemeBootstrapScript } from "./lib/theme-preference";

import { utils } from "#styles";

const themeBootstrapScript = createThemeBootstrapScript();

interface Props {
  title?: string;
  description?: string;
  canonical?: URL | string;
  noindex?: boolean;
}

const {
  title = "Quizbun: quizzes for learning",
  description = SITE_DESCRIPTION,
  canonical,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-preference="system">
  <head>
    {/* Must stay the first stylesheet in the document, and inline. A layer's
        cascade position is fixed the first time the browser sees its name, so
        the identical statement in #styles/index.css cannot do this job: Astro
        inlines some component styles above the <link> to the bundle, and
        Lightning CSS strips the statement from the chunk when minifying. Both
        together sank `ui` below `layout` on /import/ and /quizzes/. */}
    <style is:inline>@layer reset, base, layout, typography, utils, ui;</style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="manifest" href={withBase("manifest.webmanifest")} />
    <link rel="apple-touch-icon" href={withBase("icons/apple-touch-icon.png")} />
    <link rel="sitemap" href={withBase("sitemap-index.xml")} />
    <link rel="icon" href={withBase("favicon.ico")} />
    <meta name="generator" content={Astro.generator} />
    {/* Declares both schemes before the first paint, so the browser picks the
        matching canvas colour instead of flashing white. The bootstrap script
        below narrows it to a single scheme when the user has pinned one. */}
    <meta name="color-scheme" content="light dark" />
    {/* Browser chrome only. `media` is the sole selector `theme-color` accepts,
        so these follow the system preference and not the in-app `data-theme`
        override -- a pinned theme keeps the system-matched chrome. */}
    <meta name="theme-color" content={SITE_THEME_COLOR} media="(prefers-color-scheme: light)" />
    <meta
      name="theme-color"
      content={SITE_THEME_COLOR_DARK}
      media="(prefers-color-scheme: dark)"
    />
    <Font cssVariable="--font-noto-sans" preload />
    <Font cssVariable="--font-noto-mono" preload />
    <meta name="description" content={description} />
    <script is:inline set:html={themeBootstrapScript} />
    <title>{title}</title>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: withBase("/quizbun-og-image.png"),
        }
      }}
      twitter={{
        creator: "@a_dev0"
      }}
      extend={{
        link: [{ rel: "icon", href: withBase("favicon.ico") }],
        meta: [
          {
            name: "twitter:image",
            content: withBase("/quizbun-og-image.png"),
          },
          { name: "twitter:title", content: title },
          { name: "twitter:description", content: description },
        ],
      }}
    />
  </head>
  <body class={utils.cellBackground}>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <div class="root">
      <main id="content" class="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
<style>
  html {
    background-color: var(--color-cell-bg);
  }

  body {
    isolation: isolate;

    overflow-x: clip;
    overscroll-behavior-x: none;
    display: grid;
    grid-template-rows: auto 1fr auto;

    min-height: 100dvh;
  }

  body::before {
    position: fixed;
    z-index: -1;
    inset: -100%;
    transform: rotate(-2.9deg);
  }

  .root {
    background-color: var(--color-main-bg);
  }

  .main {
    width: 100%;
    max-width: var(--max-content-width);
    min-height: 100%;
    margin: 0 auto 1.5rem;
  }

  /* Keyboard skip link: visually hidden until focused (T7 keyboard pass). */
  .skip-link {
    position: absolute;
    z-index: 1;
    left: 50%;
    transform: translateX(-50%);

    margin-block-start: -.2rem;
    padding-block: .2rem;
    padding-inline: .5rem;
    border-block-end: 2px solid transparent;

    font-size: var(--fs-s);
    color: var(--color-text-on-panel);
    text-decoration: none;

    background-color: var(--color-panel-bg);
    outline: none;
  }

  .skip-link:focus,
  .skip-link:focus-visible {
    border-color: var(--color-panel-focus-ring);
  }

  .skip-link:not(:focus-visible) {
    overflow: hidden;

    width: 1px;
    height: 1px;

    white-space: nowrap;

    clip-path: inset(50%);
  }
</style>
