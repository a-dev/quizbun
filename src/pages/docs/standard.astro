---
import { loadDoc } from "@/shared/lib/docs";
import { withBase } from "@/shared/lib/routing";
import DocsLayout from "@/app/docs-layout.astro";

const doc = loadDoc("docs/standard.md");
---

<DocsLayout
  title="Quiz Object Standard"
  description="The fields, rules, correctness model, and versioning policy for Quizbun's JSON Quiz format."
>
  <Fragment set:html={doc.html} />

  <h2 id="related-resources">Related resources</h2>
  <ul>
    <li>
      <a href={withBase("schema/quiz.v1.json")}
        >Published JSON Schema (<code>quiz.v1.json</code>)</a
      >
      is the generated file for editors, validators, and AI tools.
    </li>
    <li>
      <a href={withBase("docs/examples/")}>Canonical example quizzes</a>, with one
      valid Quiz for each Question shape, ready to copy.
    </li>
    <li>
      <a href={withBase("docs/prompt/")}>AI generation prompt</a>, which packages
      the schema and an example into one copyable prompt.
    </li>
  </ul>
</DocsLayout>
