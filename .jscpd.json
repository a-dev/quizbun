{
  "pattern": "**/*.{ts,tsx,astro,css,mjs}",
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/tmp/**",
    "**/storybook-static/**",
    "**/.astro/**",
    "**/skills/**",
    "**/*.module.css.d.ts"
  ],
  "minLines": 10,
  "minTokens": 60,
  "reporters": ["console", "html", "json"],
  "output": "tmp/jscpd",
  "absolute": false,
  "gitignore": true
}
